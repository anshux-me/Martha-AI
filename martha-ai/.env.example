# All keys are free (no credit card).
GROQ_API_KEY=                                   # https://console.groq.com
GEMINI_API_KEY=                                 # https://aistudio.google.com (optional, used as fallback)

GROQ_STT_MODEL=whisper-large-v3-turbo

# Ordered fallback chains: provider:model, tried left to right on 429/5xx/removed model.
# Check the model lists in your Groq / Google AI Studio consoles and edit as needed.
CHAT_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,gemini:gemini-flash-lite-latest
REPORT_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-flash-latest
REASONING_EFFORT=low

CHAT_TEMPERATURE=0.4
CHAT_MAX_TOKENS=250
HISTORY_MAX_MESSAGES=12
RATE_LIMIT_PER_MIN=60

# Martha's voice. "groq" = Groq Orpheus (accept the model terms once in the Groq console;
# free tier is ~10 requests/min, ~100/day), falls back to the browser's voice automatically.
TTS_ENGINE=groq
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
